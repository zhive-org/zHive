{
	"name": "@zhive/cli",
	"version": "1.2.5-canary.18",
	"description": "CLI for bootstrapping zHive AI Agents",
	"repository": {
		"url": "https://github.com/zhive-org/zHive"
	},
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"cli": "dist/index.js"
	},
	"files": [
		"dist",
		"templates",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm run build:cli && pnpm run build:dashboard",
		"build:cli": "tsup",
		"build:dashboard": "cd dashboard && vite build",
		"dev:dashboard": "cd dashboard && vite",
		"check-types": "tsc -p tsconfig.build.json --noEmit",
		"dev": "DEV=true tsx src/index.ts",
		"start": "node dist/index.js",
		"deploy": "node scripts/deploy.cjs",
		"analyze": "tsx src/sandbox/analyze.ts",
		"prepublishOnly": "pnpm run build",
		"test": "vitest --run --passWithNoTests"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.0",
		"@ai-sdk/devtools": "^0.0.15",
		"@ai-sdk/google": "^3.0.0",
		"@ai-sdk/openai": "^3.0.25",
		"@ai-sdk/xai": "^3.0.0",
		"@hono/node-server": "^2.0.0",
		"@nktkas/hyperliquid": "^0.32.2",
		"@openrouter/ai-sdk-provider": "^2.3.3",
		"@zhive/sdk": "^1.0.10-canary.0",
		"ai": "^6.0.71",
		"axios": "1.6.0",
		"chalk": "^5.3.0",
		"commander": "^14.0.3",
		"dotenv": "^16.0.0",
		"fs-extra": "^11.2.0",
		"hono": "^4.12.15",
		"indicatorts": "^2.2.2",
		"ink": "^5.1.0",
		"ink-select-input": "^6.0.0",
		"ink-text-input": "^6.0.0",
		"langsmith": "^0.5.7",
		"lodash": "^4.17.23",
		"open": "^11.0.0",
		"pinets": "^0.9.13",
		"react": "^18.3.1",
		"viem": "^2.47.6",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.4",
		"@tanstack/react-query": "^5.100.6",
		"@types/fs-extra": "^11.0.4",
		"@types/lodash": "^4.17.23",
		"@types/node": "^20.10.0",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.0.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^4.2.4",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.3.0",
		"uplot": "^1.6.32",
		"vite": "^8.0.10",
		"vitest": "^3.2.4"
	},
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"hive",
		"zhive",
		"ai-agent",
		"trading",
		"cli",
		"scaffold"
	],
	"author": "zhive",
	"license": "AGPL-3.0"
}
